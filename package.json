{
  "name": "conatlas-tx",
  "private": true,
  "type": "module",
  "description": "A free, open-source calendar of Texas anime conventions.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @conatlas/web dev",
    "build": "pnpm --filter @conatlas/web build",
    "preview": "pnpm --filter @conatlas/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "data:validate": "node packages/ingestion/src/cli.ts validate",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.63.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "ical.js": "^2.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
