---
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
// The body face, preloaded so text doesn't reflow when it arrives late.
import bodyFont from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
// The heading face's main weight, for the same reason: titles reflowed when it arrived.
import headingFont from '@fontsource/zen-maru-gothic/files/zen-maru-gothic-latin-700-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (personal or error pages). */
  noindex?: boolean;
  /** The path search engines should use instead, when another page shows the same content. */
  canonical?: string;
}

const {
  title = 'ConAtlas TX',
  description = 'Discover your next anime adventure. A free, community-maintained calendar of anime conventions in Texas.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, Astro.site).href;
const image = new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site).href;
const pageTitle =
  title === 'ConAtlas TX' ? `${title} · Texas anime convention calendar` : `${title} · ConAtlas TX`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ConAtlas TX" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="ConAtlas TX, a Texas anime convention calendar: discover your next anime adventure."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Mark that JavaScript runs, so controls it powers are laid out from the first paint
      // (global.css hides them otherwise). Then apply the saved theme before paint.
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('theme');
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      } catch {
        // Storage blocked: stay on the light default.
      }
      // Apply saved-list and theme state to elements as the parser adds them, so the first paint
      // already shows it. Body scripts would run only after the stylesheets load, after first
      // paint. The page modules take over from here (lib/saved.ts uses the same key).
      try {
        const saved = new Set(JSON.parse(localStorage.getItem('conatlas-saved') || '[]'));
        const dark = document.documentElement.dataset.theme === 'dark';
        const plural = (n) => `${n} ${n === 1 ? 'convention' : 'conventions'}`;
        const fresh = (selector) =>
          [...document.querySelectorAll(`${selector}:not([data-pre])`)].map((el) => {
            el.setAttribute('data-pre', '');
            return el;
          });
        let savedPageDone = false;
        const apply = () => {
          for (const el of fresh('[data-save]')) {
            el.toggleAttribute('data-saved', saved.has(el.dataset.save));
          }
          for (const el of fresh('[data-theme-toggle]'))
            el.setAttribute('aria-checked', String(dark));
          const header = document.querySelector('[data-savable]');
          if (header) {
            const n = header.dataset.savable.split(' ').filter((id) => saved.has(id)).length;
            for (const el of fresh('[data-saved-count]')) {
              el.textContent = String(n);
              el.hidden = n === 0;
            }
          }
          // The Saved page: its data script comes after the list and the empty state.
          const ics = !savedPageDone && document.getElementById('saved-ics');
          if (!ics) return;
          savedPageDone = true;
          const list = document.querySelector('[data-saved-list]');
          let count = 0;
          for (const card of list.querySelectorAll('[data-listing]')) {
            card.hidden = !saved.has(card.dataset.listing);
            if (!card.hidden) count++;
          }
          for (const group of list.querySelectorAll('[data-filter-group]')) {
            const n = group.querySelectorAll('[data-listing]:not([hidden])').length;
            group.hidden = n === 0;
            const label = group.querySelector('[data-group-count]');
            if (label) label.textContent = plural(n);
          }
          list.hidden = count === 0;
          document.querySelector('[data-saved-empty]').hidden = count > 0;
          const { events } = JSON.parse(ics.textContent);
          const shown = [...list.querySelectorAll('[data-listing]:not([hidden])')];
          document.querySelector('[data-saved-export]').hidden = !shown.some(
            (card) => card.dataset.listing in events,
          );
          if (count > 0) {
            document.querySelector('[data-saved-heading]').textContent =
              `${count} saved ${count === 1 ? 'convention' : 'conventions'}`;
          }
        };
        const observer = new MutationObserver(apply);
        observer.observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener('DOMContentLoaded', () => {
          observer.disconnect();
          apply();
        });
      } catch {
        // Storage blocked: the page modules show an empty list.
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteHeader />
    <main
      id="main"
      class="mx-auto box-border grid w-full max-w-[1200px] flex-1 grid-cols-[minmax(0,1fr)] content-start gap-9 px-(--gutter) pt-7 pb-14"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
