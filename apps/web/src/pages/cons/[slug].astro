---
// One page per edition, past ones included, with every fact traced to its official source.
import {
  REGION_NAMES,
  dayCount,
  formatDateRange,
  OFFICIAL_SOURCE_TYPES,
  todayIn,
  weekday,
  type Edition,
  type Series,
  type Source,
} from '@conatlas/core';
import { googleCalendarUrl } from '@conatlas/calendar';
import BookmarkButton from '../../components/BookmarkButton.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Button from '../../components/Button.astro';
import CalendarExport from '../../components/CalendarExport.astro';
import DateBlock from '../../components/DateBlock.astro';
import EventCard from '../../components/EventCard.astro';
import Icon from '../../components/Icon.astro';
import Ribbon from '../../components/Ribbon.astro';
import StatusLine from '../../components/StatusLine.astro';
import AgeLabel from '../../components/AgeLabel.astro';
import VenueBlock from '../../components/VenueBlock.astro';
import Base from '../../layouts/Base.astro';
import {
  detailHref,
  editionSummary,
  editionTitle,
  eventDetails,
  getDataset,
  getUpcoming,
  href,
  postalAddress,
  regionHref,
  cityPages,
} from '../../lib/data.ts';

interface Props {
  edition: Edition;
  series: Series;
  sources: Map<string, Source>;
  siblings: Edition[];
}

export function getStaticPaths() {
  const { series, editions, sources } = getDataset();
  const sourceMap = new Map(sources.map((s) => [s.id, s]));
  return editions.map((edition) => ({
    params: { slug: edition.slug },
    props: {
      edition,
      series: series.find((s) => s.id === edition.series)!,
      sources: sourceMap,
      siblings: editions.filter((e) => e.series === edition.series && e.id !== edition.id),
    },
  }));
}

const { edition: e, series, sources, siblings } = Astro.props;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const FACT_LABELS = {
  existence: 'Announced',
  dates: 'Dates',
  venue: 'Venue',
  city: 'City',
  status: 'Status',
  tickets: 'Tickets',
  age: 'Age limit',
};
const today = todayIn('America/Chicago');
const name = e.name ?? series.name;
const title = editionTitle(e, series.name);
const start = e.start_date;
const end = e.end_date ?? start;
const [, sm, sd] = start ? start.split('-').map(Number) : [];
const [, em, ed] = end ? end.split('-').map(Number) : [];
const cancelled = e.status === 'cancelled';
const ended = e.status === 'completed' || (end !== undefined && end < today);
const longDate = (d: string) => formatDateRange(d, d);
const cityHref = cityPages().get(e.city);
const description = e.description ?? series.description;
// Event structured data for every edition with dates, carrying its status: Google asks that a
// cancelled or postponed event keep its dates and say so. Every value is one the page shows;
// the venue name and organizer are left out when the data has none.
const event =
  start && end
    ? {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: title,
        startDate: start,
        endDate: end,
        eventStatus: `https://schema.org/${cancelled ? 'EventCancelled' : e.status === 'postponed' ? 'EventPostponed' : 'EventScheduled'}`,
        location: {
          '@type': 'Place',
          ...(e.venue && { name: e.venue.name }),
          address: postalAddress(e),
        },
        ...(series.organizer && {
          organizer: { '@type': 'Organization', name: series.organizer },
        }),
        url: new URL(detailHref(e), Astro.site).href,
        ...(e.min_age && { typicalAgeRange: `${e.min_age}-` }),
        ...(description && { description }),
      }
    : undefined;
// Other series coming up in the same region or city, soonest first.
const nearby = getUpcoming()
  .filter(
    (x) => !x.awaitingNext && x.series !== e.series && (x.region === e.region || x.city === e.city),
  )
  .slice(0, 3);
const google = e.status === 'confirmed' && !ended && googleCalendarUrl(e, eventDetails(e, title));
// The organizer's announcement behind a hiatus or ended status.
const statusSource = series.sources
  .map((id) => sources.get(id))
  .find((s) => s && OFFICIAL_SOURCE_TYPES.includes(s.type) && s.supports.includes('status'));
// The edition to point a past page at: the soonest sibling that hasn't ended.
// A series that has ended or is on hiatus has no current edition, even a cancelled one.
const current = siblings
  .filter(
    (s) =>
      series.status === 'active' &&
      s.status !== 'completed' &&
      (!s.end_date || s.end_date >= today),
  )
  .sort((a, b) => (a.start_date ?? '9999').localeCompare(b.start_date ?? '9999'))[0];
// Everything that has ended, so an edition still awaiting its "completed" status stays linked.
const past = siblings
  .filter((s) => s.status === 'completed' || (s.end_date !== undefined && s.end_date < today))
  .sort((a, b) => (b.start_date ?? '').localeCompare(a.start_date ?? ''));
---

<Base
  title={title}
  description={`${
    cancelled
      ? `${title} in ${e.city}, Texas, is cancelled.`
      : e.status === 'postponed'
        ? `${title} in ${e.city}, Texas, is postponed and awaiting new dates.`
        : !start || !end
          ? `${title} in ${e.city}, Texas. Dates not announced yet.`
          : ended
            ? `${title} ran ${formatDateRange(start, end)} in ${e.city}, Texas.`
            : `${title}, ${formatDateRange(start, end)} in ${e.city}, Texas.`
  } Dates, venue and official sources, checked against the organizer's site.`}
>
  {event && (
    <script
      type="application/ld+json"
      slot="head"
      set:html={JSON.stringify(event).replace(/</g, '\\u003c')}
    />
  )}
  <div class="grid max-w-[1024px] grid-cols-[minmax(0,1fr)] gap-7">
    <Breadcrumb items={[{ label: 'Explore', href: href() }, { label: name }]} />

    <header class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-5">
      <DateBlock
        size="lg"
        month={sm ? MONTHS[sm - 1]! : 'TBA'}
        day={sd}
        endDay={start !== end && sm === em ? ed : undefined}
        weekday={
          start && end
            ? start === end
              ? weekday(start)
              : `${weekday(start)}–${weekday(end)}`
            : undefined
        }
        tentative={!start}
        cancelled={cancelled}
      />
      <div class="grid min-w-0 gap-2.5">
        <div class="flex flex-wrap items-center gap-2">
          <StatusLine edition={e} badge />
          {e.min_age && <AgeLabel minAge={e.min_age} />}
          <span class="eyebrow">{REGION_NAMES[e.region]}</span>
        </div>
        <h1
          id="con-title"
          class:list={['m-0 [font:var(--type-h1)] text-balance', cancelled && 'struck']}
        >
          {name}
        </h1>
        <span class="pixel">{e.edition}</span>
        <span class="range">
          {start && end ? (
            <>
              <time datetime={start === end ? start : `${start}/${end}`}>
                {start === end ? weekday(start) : `${weekday(start)}–${weekday(end)}`},{' '}
                {formatDateRange(start, end)}
              </time>
              {dayCount(start, end) > 1 && (
                <span class="range__days">· {dayCount(start, end)} days</span>
              )}
            </>
          ) : (
            <span class="range--tentative">
              {e.announced_window
                ? `Expected ${e.announced_window} · dates not announced`
                : 'Dates not announced'}
            </span>
          )}
        </span>
        <VenueBlock name={e.venue?.name} city={e.city} />
      </div>
    </header>

    {e.status === 'postponed' && (
      <div class="banner banner--warning" role="status">
        <Icon name="triangle-alert" size={18} />
        <span>
          <b>Postponed.</b> {e.status_note}
          {start && ' The dates shown are the original ones and should not be relied on.'}
        </span>
      </div>
    )}
    {cancelled && (
      <div class="banner banner--cancelled" role="status">
        <Icon name="circle-x" size={18} />
        <span>
          <b>Cancelled.</b> {e.status_note}
        </span>
      </div>
    )}
    {series.status !== 'active' && (
      <div class="banner banner--neutral" role="status" data-series-status={series.status}>
        <Icon name="info" size={18} />
        <span>
          <b>
            {series.status === 'ended'
              ? `${series.name} has ended.`
              : `${series.name} is on hiatus.`}
          </b>{' '}
          {series.status_note}
        </span>
        {statusSource && (
          <a class="banner__link" href={statusSource.url} target="_blank" rel="noopener noreferrer">
            Read the announcement
            <Icon name="external-link" size={12} label="(opens in new tab)" />
          </a>
        )}
      </div>
    )}
    {ended && !cancelled && (
      <div class="banner banner--neutral" role="status">
        <Icon name="calendar" size={18} />
        <span>
          This edition has ended. Kept for reference.
          {!current &&
            series.status === 'active' &&
            " The organizer hasn't announced the next one yet."}
        </span>
        {current && (
          <a class="banner__link" href={detailHref(current)}>
            See the current edition →
          </a>
        )}
      </div>
    )}

    <div class="grid gap-2">
      <div class="actions flex flex-wrap items-center gap-2.5">
        {!ended && <BookmarkButton id={e.id} describedby="con-title" />}
        {google && <CalendarExport ics={href(`cons/${e.slug}.ics`)} google={google} />}
        <Button variant="secondary" href={e.url} external>
          Visit official site
        </Button>
        {e.tickets_url && !ended && (
          <Button variant="ghost" href={e.tickets_url} external>
            Tickets
          </Button>
        )}
      </div>
      {e.min_age && (
        <p
          class="m-0 flex items-start gap-1.5 [font:var(--type-body-sm)] text-text-2"
          data-age-notice
        >
          <Icon name="info" size={16} />
          This convention is for adults. Its official site may show mature content.
        </p>
      )}
    </div>

    <div class="detail-cols">
      <div class="grid min-w-0 content-start gap-6">
        <section class="grid gap-3">
          <Ribbon rule heading>
            About
          </Ribbon>
          <p class="m-0 max-w-[68ch] text-pretty text-text-2" data-summary>
            {editionSummary(e, series, today)}
          </p>
          {description && <p class="m-0 max-w-[68ch] text-pretty text-text-2">{description}</p>}
        </section>
        <section class="grid gap-3">
          <Ribbon tone="sage" rule heading>
            Venue
          </Ribbon>
          {e.venue ? (
            <VenueBlock
              card
              name={e.venue.name}
              address={e.venue.address}
              city={e.city}
              region={REGION_NAMES[e.region]}
              regionHref={regionHref(e.region)}
              cityHref={cityHref}
            />
          ) : (
            <p class="m-0 [font:var(--type-body-sm)] text-text-muted">
              Venue not announced yet. City: {cityHref ? <a href={cityHref}>{e.city}</a> : e.city},{' '}
              <a href={regionHref(e.region)}>{REGION_NAMES[e.region]}</a>.
            </p>
          )}
        </section>
        {past.length > 0 && (
          <section class="grid gap-3">
            <Ribbon tone="lavender" rule heading>
              Past editions
            </Ribbon>
            <ul class="m-0 grid gap-1.5 pl-5 [font:var(--type-body-sm)] text-text-2">
              {past.map((p) => (
                <li>
                  <a href={detailHref(p)}>
                    {p.edition}
                    {p.start_date &&
                      ` · ${formatDateRange(p.start_date, p.end_date ?? p.start_date)}`}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside class="grid min-w-0 content-start gap-3" aria-labelledby="verify-h">
        <h2 id="verify-h" class="m-0 flex items-center gap-2 [font:var(--type-h4)]">
          <Icon name="badge-check" size={18} />
          Verification
        </h2>
        <p class="m-0 [font:var(--type-body-sm)] text-text-2">
          Information verified from the organizer's official sources on{' '}
          {longDate(e.last_verified_at)}.
        </p>
        <div class="source">
          {series.organizer && (
            <div class="source__row">
              <span class="source__k">Organizer</span>
              <span class="source__v">{series.organizer}</span>
            </div>
          )}
          {e.evidence.map((ev) => {
            const source = sources.get(ev.source)!;
            return (
              <div class="source__ev">
                <span class="source__k">{ev.facts.map((f) => FACT_LABELS[f]).join(', ')}</span>
                <a class="source__link" href={source.url} target="_blank" rel="noopener noreferrer">
                  {new URL(source.url).hostname.replace(/^www\./, '')}
                  {new URL(source.url).pathname !== '/' && new URL(source.url).pathname}
                  <Icon name="external-link" size={11} label="(opens in new tab)" />
                </a>
                {ev.excerpt && <blockquote class="source__quote">“{ev.excerpt}”</blockquote>}
                {ev.note && <p class="source__note">{ev.note}</p>}
              </div>
            );
          })}
          <div class="source__foot">Last checked {longDate(e.last_verified_at)}</div>
        </div>
        <p class="m-0 [font:var(--type-caption)] text-text-muted">
          "Last checked" is when a maintainer compared this listing with the official site. Quotes
          are copied from the organizer's pages on that day.
        </p>
        <p class="m-0 [font:var(--type-body-sm)]">
          Something's off? <a href={href(`contribute/?con=${e.id}`)}>Suggest a correction</a>
        </p>
      </aside>
    </div>

    {nearby.length > 0 && (
      <section class="grid gap-3">
        <Ribbon tone="lavender" rule heading>
          Nearby and upcoming
        </Ribbon>
        <div class="grid gap-1.5">
          {nearby.map((listing) => (
            <EventCard listing={listing} compact />
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .eyebrow {
    font: var(--type-meta);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }
  .pixel {
    font: var(--type-pixel);
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .struck {
    text-decoration: line-through;
    text-decoration-color: var(--status-cancelled-dot);
  }
  .range {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font: var(--type-h4);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .range__days {
    font-weight: 400;
    color: var(--text-muted);
  }
  .range--tentative {
    color: var(--text-2);
    font-style: italic;
    font-weight: 500;
  }
  .banner {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: flex-start;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    font: var(--type-body-sm);
  }
  .banner--warning {
    background: var(--status-warning-bg);
    color: var(--status-warning-fg);
  }
  .banner--cancelled {
    background: var(--status-cancelled-bg);
    color: var(--status-cancelled-fg);
  }
  .banner--neutral {
    align-items: center;
    background: var(--status-neutral-bg);
    color: var(--status-neutral-fg);
  }
  /* The text takes the room beside the icon, so a long note wraps inside it. */
  .banner > span {
    flex: 1 1 0;
    min-width: 12ch;
  }
  .banner__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    font-weight: 600;
  }
  /* On phones the actions share each row evenly instead of leaving one alone. */
  @media (max-width: 640px) {
    .actions > :global(*) {
      flex: 1 1 auto;
      justify-content: center;
    }
    .actions :global(.exp__btn) {
      box-sizing: border-box;
      width: 100%;
      justify-content: center;
    }
  }
  .detail-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .detail-cols {
      grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
    }
  }
  .source {
    display: grid;
    gap: 12px;
    padding: 16px;
    border-radius: var(--radius-md);
    background: var(--surface-2);
    font: var(--type-body-sm);
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .source__row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .source__k {
    font: var(--type-meta);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
    min-width: 84px;
  }
  .source__v {
    color: var(--text);
    font-weight: 500;
  }
  .source__ev {
    display: grid;
    gap: 4px;
  }
  .source__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .source__quote {
    margin: 0;
    padding-left: 10px;
    border-left: 2px solid var(--border-strong);
    color: var(--text);
    font-style: italic;
  }
  .source__note {
    margin: 0;
    font: var(--type-caption);
    color: var(--text-muted);
  }
  .source__foot {
    font: var(--type-caption);
    color: var(--text-muted);
    border-top: 1px dotted var(--border-strong);
    padding-top: 10px;
  }
</style>
