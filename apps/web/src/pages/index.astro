---
import Button from '../components/Button.astro';
import EmptyState from '../components/EmptyState.astro';
import FilterBar from '../components/FilterBar.astro';
import Icon from '../components/Icon.astro';
import Motif from '../components/Motif.astro';
import Ribbon from '../components/Ribbon.astro';
import Timeline from '../components/Timeline.astro';
import ViewTabs from '../components/ViewTabs.astro';
import Base from '../layouts/Base.astro';
import { REGIONS, REGION_NAMES } from '@conatlas/core';
import { getUpcoming, href } from '../lib/data.ts';

const listings = getUpcoming();
const cities = [...new Set(listings.map((e) => e.city))].sort();
// The hero counts what's coming up; past editions standing in for their series are left out.
const upcoming = listings.filter((e) => !e.awaitingNext);
const verified = upcoming.filter((e) => e.status === 'confirmed').length;
const upcomingCities = new Set(upcoming.map((e) => e.city)).size;
const regions = REGIONS.map((id) => {
  const here = upcoming.filter((e) => e.region === id);
  const names = [...new Set(here.map((e) => e.city))];
  return {
    id,
    name: REGION_NAMES[id],
    count: here.length,
    // A no-break space keeps each dot with the city before it, so no line starts with one.
    cities: names.length ? names.join('\u00a0· ') : 'No upcoming listings',
  };
});
const STEPS = [
  {
    title: 'Official site only',
    text: "Dates and venues come from the organizer's own website or announcement. Nothing is copied from third-party listings.",
  },
  {
    title: 'Human-reviewed changes',
    text: 'Every edit is a reviewed change to a public data file. Each listing shows the day it was last checked.',
  },
  {
    title: 'Honest about unknowns',
    text: 'Unannounced dates are never guessed onto a weekend. They sit in their own "Dates not announced" group until confirmed.',
  },
];
---

<Base>
  <!-- Search Console ownership check for https://conatlas-tx.vercel.app/ (keep while verified). -->
  <meta
    slot="head"
    name="google-site-verification"
    content="GX70Ol62uOHT-yuGzrRKexJDnSKl7nIhmuhnbulJtP0"
  />
  <section class="relative grid gap-[18px] overflow-hidden rounded-lg border border-border bg-surface p-[clamp(24px,4vw,44px)]">
    <Motif
      kind="flower"
      size={150}
      color="var(--accent-soft)"
      center="var(--surface)"
      class="absolute -top-10 -right-7.5"
    />
    <Motif
      kind="sparkle"
      size={26}
      color="var(--brand-lavender)"
      class="absolute top-16 right-35 max-sm:hidden"
    />
    <span class="font-pixel text-[length:var(--fs-pixel)] tracking-[.08em] text-text-muted">
      VOL.01 · TEXAS
    </span>
    <h1 class="relative m-0 max-w-[16ch] [font:var(--type-display)] tracking-[-.02em] text-balance">
      Find your next anime adventure in Texas.
    </h1>
    <p class="m-0 max-w-[52ch] [font:var(--type-body-lg)] text-pretty text-text-2">
      From San Antonio to Houston, Austin to DFW—discover upcoming anime conventions, save your
      favorites, and plan your con year.
    </p>
    <p class="m-0 flex flex-wrap items-center gap-3.5 [font:var(--type-caption)] text-text-muted">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="badge-check" size={14} />
        {verified} verified against organizer sites
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="calendar" size={14} />
        {upcoming.length} upcoming conventions
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="map-pin" size={14} />
        {upcomingCities} cities
      </span>
    </p>
  </section>

  {listings.length === 0 ? (
    <EmptyState
      title="Nothing here yet"
      description="No conventions have been verified against an organizer's site yet. Listings appear here once a maintainer confirms them."
    />
  ) : (
    <>
      <section
        id="upcoming"
        class="grid grid-cols-[minmax(0,1fr)] gap-4"
        aria-label="Upcoming conventions"
      >
        <div class="flex flex-wrap items-center justify-between gap-4">
          <Ribbon>Upcoming</Ribbon>
          <ViewTabs current="list" />
        </div>
        <FilterBar cities={cities} total={listings.length} />
      </section>
      <Timeline listings={listings} />
      <EmptyState
        title="Nothing here yet"
        description="Try widening the region or clearing a city. Conventions with dates still to be announced are listed at the end of the timeline."
        data-filter-empty
        hidden
      >
        <Button variant="secondary" data-clear-filters>
          Clear filters
        </Button>
      </EmptyState>
    </>
  )}

  <section id="regions" class="grid gap-4">
    <Ribbon tone="lavender" rule heading>
      Explore by Texas region
    </Ribbon>
    <ul class="regions">
      {regions.map((r) => (
        <li>
          <a class="region" href={href(`?region=${r.id}#upcoming`)}>
            <span class="region__top">
              <span class="region__name">{r.name}</span>
              <span class="region__count">
                {r.count}
                <span class="sr-only">
                  {r.count === 1 ? ' upcoming convention' : ' upcoming conventions'}
                </span>
              </span>
            </span>
            <span class="region__cities">{r.cities}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="grid gap-4">
    <Ribbon tone="sage" rule heading>
      How we verify events
    </Ribbon>
    <ol class="steps">
      {STEPS.map((step, i) => (
        <li class="step">
          <span class="step__n">STEP 0{i + 1}</span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__text">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="flex flex-wrap items-center justify-between gap-4 rounded-md border-[1.5px] border-dashed border-border-strong px-6 py-5">
    <div class="grid gap-1">
      <strong class="[font:var(--type-h4)]">Know a con we're missing?</strong>
      <span class="[font:var(--type-body-sm)] text-text-2">
        ConAtlas is community-maintained. Suggestions and corrections are welcome, with or without a
        GitHub account.
      </span>
    </div>
    <Button variant="soft" href={href('contribute/')}>
      <Icon name="plus" size={16} />
      Suggest a convention
    </Button>
  </section>
</Base>

<style>
  .regions,
  .steps {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .regions {
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  .steps {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .region {
    display: grid;
    align-content: start;
    gap: 6px;
    box-sizing: border-box;
    height: 100%;
    min-height: 88px;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
    color: var(--text);
    text-decoration: none;
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .region:hover {
    box-shadow: var(--shadow-2);
    border-color: var(--border-strong);
  }
  .region:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }
  .region__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .region__name {
    font: var(--type-h4);
  }
  .region__count {
    font: var(--type-date-day);
    font-size: 24px;
    color: var(--brand-pink-ink);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .region__cities {
    font: var(--type-caption);
    color: var(--text-muted);
  }
  .step {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 18px;
    background: var(--surface-2);
    border-radius: var(--radius-md);
  }
  .step__n {
    font: var(--type-pixel);
    letter-spacing: 0.08em;
    color: var(--text-2);
  }
  .step__title {
    margin: 0;
    font: var(--type-h4);
  }
  .step__text {
    margin: 0;
    font: var(--type-body-sm);
    color: var(--text-2);
  }
</style>
