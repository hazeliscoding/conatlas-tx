---
import { todayIn } from '@conatlas/core';
import CalendarView from '../../components/CalendarView.astro';
import Base from '../../layouts/Base.astro';
import { calendarMonths } from '../../lib/calendar.ts';
import { getUpcoming } from '../../lib/data.ts';

// The current month lives at /calendar/, so it gets no page of its own here.
export function getStaticPaths() {
  const [, ...later] = calendarMonths(todayIn('America/Chicago'), getUpcoming());
  return later.map((month) => ({ params: { month } }));
}

const { month } = Astro.params;
---

<Base title="Calendar" description="Texas anime conventions on a month calendar.">
  <CalendarView month={month} />
</Base>
