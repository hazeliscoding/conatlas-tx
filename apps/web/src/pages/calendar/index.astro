---
import { todayIn } from '@conatlas/core';
import CalendarView from '../../components/CalendarView.astro';
import Base from '../../layouts/Base.astro';
---

<Base
  title="Texas anime conventions by month"
  description="Every upcoming anime convention in Texas on a month calendar, with dates checked against each organizer's own site."
>
  <CalendarView month={todayIn('America/Chicago').slice(0, 7)} />
</Base>
