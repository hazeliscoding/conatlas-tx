---
// Brand motifs from the design system's Motif component. Always decorative. The flower was
// redrawn on 2026-10-13: five identical petals turned evenly, optically centered in the box.
const PATHS = {
  flower:
    'M12 11.81A5.4 3.74 -90 1 0 12 1A5.4 3.74 -90 1 0 12 11.81ZM12.59 12.24A5.4 3.74 -18 1 0 22.87 8.9A5.4 3.74 -18 1 0 12.59 12.24ZM12.37 12.94A5.4 3.74 54 1 0 18.72 21.68A5.4 3.74 54 1 0 12.37 12.94ZM11.63 12.94A5.4 3.74 126 1 0 5.28 21.68A5.4 3.74 126 1 0 11.63 12.94ZM11.41 12.24A5.4 3.74 198 1 0 1.13 8.9A5.4 3.74 198 1 0 11.41 12.24Z',
  sparkle:
    'M12 1c.6 6.5 4.5 10.4 11 11-6.5.6-10.4 4.5-11 11-.6-6.5-4.5-10.4-11-11C7.5 11.4 11.4 7.5 12 1z',
};

interface Props {
  kind: keyof typeof PATHS;
  size: number;
  color: string;
  /** Fill for the flower's center dot. */
  center?: string;
  class?: string;
}

const { kind, size, color, center = 'var(--bg)', class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={color}
  aria-hidden="true"
  focusable="false"
>
  <path d={PATHS[kind]}></path>
  {kind === 'flower' && <circle cx="12" cy="12.43" r="3.12" fill={center} />}
</svg>
