---
// Brand motifs from the design system's Motif component. Always decorative.
const PATHS = {
  flower:
    'M12 2c2.2 0 3.6 2 3.1 4.2 2-1 4.4.2 4.9 2.3.5 2.1-1 3.9-3.1 4 2.1.1 3.6 1.9 3.1 4-.5 2.1-2.9 3.3-4.9 2.3C15.6 21 14.2 23 12 23s-3.6-2-3.1-4.2c-2 1-4.4-.2-4.9-2.3-.5-2.1 1-3.9 3.1-4-2.1-.1-3.6-1.9-3.1-4 .5-2.1 2.9-3.3 4.9-2.3C8.4 4 9.8 2 12 2z',
  sparkle:
    'M12 1c.6 6.5 4.5 10.4 11 11-6.5.6-10.4 4.5-11 11-.6-6.5-4.5-10.4-11-11C7.5 11.4 11.4 7.5 12 1z',
};

interface Props {
  kind: keyof typeof PATHS;
  size: number;
  color: string;
  /** Fill for the flower's center dot. */
  center?: string;
  class?: string;
}

const { kind, size, color, center = 'var(--bg)', class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={color}
  aria-hidden="true"
  focusable="false"
>
  <path d={PATHS[kind]}></path>
  {kind === 'flower' && <circle cx="12" cy="12.5" r="2.4" fill={center} />}
</svg>
