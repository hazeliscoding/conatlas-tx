---
// Dark mode switch. Shown only when JavaScript runs (global.css); Base.astro applies the saved theme before paint.
import Icon from './Icon.astro';

interface Props {
  /** Visible label; without it the switch is labelled for screen readers only. */
  label?: string;
}

const { label } = Astro.props;
---

<button
  type="button"
  role="switch"
  aria-checked="false"
  class="switch"
  aria-label={label ? undefined : 'Dark mode'}
  data-theme-toggle
>
  <span class="switch__track">
    <span class="switch__thumb">
      <span class="switch__sun">
        <Icon name="sun" size={12} strokeWidth={2.2} />
      </span>
      <span class="switch__moon">
        <Icon name="moon" size={12} strokeWidth={2.2} />
      </span>
    </span>
  </span>
  {label && <span>{label}</span>}
</button>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    toggles.forEach((t) => t.setAttribute('aria-checked', String(dark)));
  };
  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      try {
        localStorage.setItem('theme', theme);
      } catch {
        // Private browsing can block storage; the theme still applies for this page.
      }
      sync();
    });
  });
  sync();
</script>

<style>
  .switch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch-min);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--text);
    font: var(--type-body-sm);
  }
  .switch__track {
    position: relative;
    width: 44px;
    height: 26px;
    border-radius: var(--radius-full);
    background: var(--border-strong);
    transition: background-color var(--dur-base) var(--ease-out);
    flex: none;
  }
  .switch__thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--surface-raised);
    box-shadow: var(--shadow-1);
    display: grid;
    place-items: center;
    color: var(--text-2);
    transition: transform var(--dur-base) var(--ease-out);
  }
  /* Drawn from the theme the head script sets before paint, not from aria-checked. */
  :global([data-theme='dark']) .switch__track {
    background: var(--accent);
  }
  :global([data-theme='dark']) .switch__thumb {
    transform: translateX(18px);
    color: var(--accent);
  }
  .switch__sun,
  .switch__moon {
    display: inline-flex;
  }
  :global([data-theme='dark']) .switch__sun,
  :global(:root:not([data-theme='dark'])) .switch__moon {
    display: none;
  }
  .switch:focus-visible {
    outline: none;
  }
  .switch:focus-visible .switch__track {
    box-shadow: var(--shadow-focus);
  }
</style>
