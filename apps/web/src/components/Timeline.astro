---
// Listings grouped by month; undated ones close the list under "Dates not announced".
import type { Listing } from '../lib/data.ts';
import type { Tone } from './DateBlock.astro';
import EventCard from './EventCard.astro';

interface Props {
  listings: Listing[];
}

const MONTHS = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];
const TONES: Tone[] = ['pink', 'lavender', 'sage'];
const plural = (n: number) => `${n} ${n === 1 ? 'convention' : 'conventions'}`;

// Listings arrive sorted with undated, then awaiting-next ones last, so groups come out in order.
const UNDATED: Record<string, string> = {
  tba: 'Dates not announced',
  next: 'Next dates not announced',
};
const groups = new Map<string, Listing[]>();
for (const listing of Astro.props.listings) {
  const key = listing.awaitingNext ? 'next' : (listing.start_date?.slice(0, 7) ?? 'tba');
  groups.set(key, [...(groups.get(key) ?? []), listing]);
}
---

<div class="tl">
  {[...groups].map(([key, listings], gi) => {
    const [year, month] = key.split('-').map(Number);
    return (
      <section
        class:list={['tl__group', UNDATED[key] && 'tl__group--tba']}
        aria-labelledby={`tl-${key}`}
        data-filter-group
      >
        <div class="tl__head">
          <h2 class="tl__month" id={`tl-${key}`}>
            {UNDATED[key] ?? MONTHS[month! - 1]}
          </h2>
          {!UNDATED[key] && <span class="tl__year">{year}</span>}
          <span class="tl__count" data-group-count>
            {plural(listings.length)}
          </span>
        </div>
        <div class="tl__list">
          {listings.map((listing, i) => (
            <EventCard listing={listing} tone={TONES[(gi + i) % 3]} />
          ))}
        </div>
      </section>
    );
  })}
</div>

<style>
  .tl {
    display: grid;
    gap: var(--space-8);
  }
  .tl__group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .tl__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  @media (min-width: 768px) {
    .tl__group {
      grid-template-columns: 148px minmax(0, 1fr);
      gap: 24px;
    }
    .tl__head {
      position: sticky;
      top: calc(var(--header-h) + 16px);
      align-self: start;
      flex-direction: column;
      gap: 2px;
      padding-top: 4px;
      border-top: 2px solid var(--brand-plum);
    }
    .tl__group--tba .tl__head {
      border-top-style: dashed;
      border-top-color: var(--cal-tentative-border);
    }
    .tl__group--tba .tl__month {
      font: var(--type-h4);
      text-wrap: balance;
    }
  }
  .tl__month {
    font: var(--type-h3);
    color: var(--text);
  }
  .tl__year {
    font: var(--type-pixel);
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .tl__count {
    font: var(--type-caption);
    color: var(--text-muted);
  }
  .tl__list {
    display: grid;
    gap: 12px;
  }
</style>
