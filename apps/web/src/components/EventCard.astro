---
// The discovery unit: date block, name, dates and venue, status, save toggle, official link.
// The title links to the detail page and stretches over the whole card.
import { REGION_NAMES, dayCount, formatDateRange, weekday } from '@conatlas/core';
import { detailHref, type Listing } from '../lib/data.ts';
import BookmarkButton from './BookmarkButton.astro';
import DateBlock, { type Tone } from './DateBlock.astro';
import Icon from './Icon.astro';
import StatusLine from './StatusLine.astro';

interface Props {
  listing: Listing;
  tone?: Tone;
  /** Smaller card for secondary lists: no region eyebrow, year or official link, icon-only Save. */
  compact?: boolean;
}

const { listing: e, tone, compact } = Astro.props;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const start = e.start_date;
const end = e.end_date ?? start;
const [, sm, sd] = start ? start.split('-').map(Number) : [];
const [, em, ed] = end ? end.split('-').map(Number) : [];
const cancelled = e.status === 'cancelled';
// A past edition standing in for a series whose next dates aren't announced: no date claims.
const dated = start && end && !e.awaitingNext;
const savable = !e.awaitingNext;
const titleId = `ev-${e.id}`;
---

<article
  class:list={['ev', compact && 'ev--compact', cancelled && 'ev--cancelled']}
  aria-labelledby={titleId}
  data-listing={e.id}
  data-region={e.region}
  data-city={e.city}
>
  <DateBlock
    month={dated ? MONTHS[sm! - 1]! : 'TBA'}
    day={dated ? sd : undefined}
    endDay={dated && start !== end && sm === em ? ed : undefined}
    weekday={
      dated && !compact
        ? start === end
          ? weekday(start)
          : `${weekday(start)}–${weekday(end)}`
        : undefined
    }
    size={compact ? 'sm' : undefined}
    tone={tone}
    tentative={!dated}
    cancelled={cancelled}
  />
  <div class="ev__body">
    {!compact && <div class="ev__eyebrow">{REGION_NAMES[e.region]}</div>}
    <h3 class="ev__title" id={titleId}>
      <a href={detailHref(e)}>{e.displayName}</a>
    </h3>
    <div class="ev__meta">
      {dated ? (
        <span class="ev__range">
          <time datetime={start === end ? start : `${start}/${end}`}>
            {formatDateRange(start, end, { year: !compact })}
          </time>
          {!compact && dayCount(start, end) > 1 && (
            <span class="ev__days">· {dayCount(start, end)} days</span>
          )}
        </span>
      ) : (
        <span class="ev__range ev__range--tentative">
          {e.awaitingNext && start && end
            ? `Last held ${formatDateRange(start, end)}`
            : e.announced_window
              ? `Expected ${e.announced_window} · not announced`
              : 'Dates not announced'}
        </span>
      )}
      <span>
        <Icon name="map-pin" size={14} />
        {e.venue && !e.awaitingNext ? `${e.venue.name}, ${e.city}` : e.city}
      </span>
    </div>
    <div class="ev__foot">
      <StatusLine edition={e} awaitingNext={e.awaitingNext} />
    </div>
  </div>
  <div class="ev__actions">
    {savable && <BookmarkButton id={e.id} describedby={titleId} iconOnly={compact} />}
    {!compact && (
      <a class="ev__official" href={e.url} target="_blank" rel="noopener noreferrer">
        Official site <Icon name="external-link" size={12} label="(opens in new tab)" />
      </a>
    )}
  </div>
</article>

<style>
  .ev {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
    color: var(--text);
  }
  .ev:hover {
    box-shadow: var(--shadow-2);
    border-color: var(--border-strong);
  }
  .ev:has(.ev__title a:focus-visible) {
    box-shadow: var(--shadow-focus);
  }
  .ev--compact {
    padding: 12px 14px;
    gap: 12px;
    border-radius: var(--radius-sm);
    box-shadow: none;
  }
  .ev--compact .ev__title {
    font: var(--type-h4);
    font-size: 17px;
  }
  .ev--compact .ev__actions {
    justify-content: center;
  }
  .ev--cancelled {
    background: var(--surface-2);
  }
  .ev--cancelled .ev__title {
    color: var(--text-2);
    text-decoration: line-through;
    text-decoration-color: var(--status-cancelled-dot);
  }
  .ev__body {
    display: grid;
    gap: 6px;
    min-width: 0;
    align-content: start;
  }
  .ev__eyebrow {
    font: var(--type-meta);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }
  .ev__title {
    font: var(--type-h3);
    font-size: clamp(18px, 1.1rem + 0.4vw, 22px);
    text-wrap: balance;
  }
  .ev__title a {
    color: inherit;
    text-decoration: none;
  }
  .ev__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .ev__title a:hover {
    color: var(--link);
  }
  .ev__title a:focus-visible {
    outline: none;
  }
  .ev__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font: var(--type-body-sm);
    color: var(--text-2);
    align-items: center;
  }
  .ev__meta > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ev__range {
    font-weight: 500;
    color: var(--text);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .ev__range--tentative {
    color: var(--text-2);
    font-style: italic;
  }
  .ev--cancelled .ev__range time {
    text-decoration: line-through;
    text-decoration-color: var(--status-cancelled-dot);
    color: var(--text-muted);
  }
  .ev__days {
    font-weight: 400;
    color: var(--text-muted);
  }
  .ev__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: center;
    margin-top: 2px;
  }
  .ev__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-end;
  }
  .ev__official {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    min-height: 44px;
    font: var(--type-caption);
    color: var(--text-2);
  }
  .ev__official:hover {
    color: var(--link);
    text-decoration-thickness: 2px;
  }
  @media (max-width: 480px) {
    .ev {
      grid-template-columns: auto 1fr;
      padding: 16px;
    }
    .ev__actions {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: flex-end;
    }
    /* The compact card's icon-only Save fits beside the text. */
    .ev--compact {
      grid-template-columns: auto 1fr auto;
    }
    .ev--compact .ev__actions {
      grid-column: auto;
    }
  }
</style>
