---
// Breadcrumb trail; on small screens only the parent link shows.
import Icon from './Icon.astro';

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
// The same trail for search engines. The last crumb isn't a link, so it has no `item` and
// stands for this page.
const data = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href && i < items.length - 1 && { item: new URL(item.href, Astro.site).href }),
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {i > 0 && (
          <span class="crumbs__sep">
            <Icon name="chevron-right" size={14} />
          </span>
        )}
        {i === items.length - 1 ? (
          <span aria-current="page">{item.label}</span>
        ) : (
          <a href={item.href}>
            <span class="crumbs__back">
              <Icon name="chevron-left" size={14} />
            </span>
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
<style>
  ol {
    list-style: none;
    /* The links' 4px padding is hit area; line their text up with the content edge. */
    margin: 0 0 0 -4px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    font: var(--type-body-sm);
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  a {
    color: var(--text-2);
    text-decoration: none;
    padding: 6px 4px;
    border-radius: var(--radius-xs);
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }
  a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  [aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    padding: 6px 4px;
  }
  .crumbs__sep {
    display: inline-flex;
    color: var(--text-muted);
  }
  .crumbs__back {
    display: none;
  }
  @media (max-width: 640px) {
    li:not(:nth-last-child(2)) {
      display: none;
    }
    li:nth-last-child(2) .crumbs__sep {
      display: none;
    }
    /* Only the parent shows here, so it reads as a back link. */
    li:nth-last-child(2) .crumbs__back {
      display: inline-flex;
    }
  }
</style>
