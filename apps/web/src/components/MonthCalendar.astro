---
// A month as a grid with event bars (768px and up) or an agenda list (narrower screens).
// Bars and agenda entries are links carrying the full name and dates, so day numbers stay decorative.
import { formatDateRange, weekday } from '@conatlas/core';
import { monthWeeks, type Month } from '../lib/calendar.ts';
import { detailHref, type Listing } from '../lib/data.ts';
import Icon from './Icon.astro';

interface Props {
  month: Month;
  title: string;
  listings: Listing[];
  today: string;
}

const { month, title, listings, today } = Astro.props;
const DOW = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const weeks = monthWeeks(month, listings);
const inMonth = (date: string) => date.startsWith(month);

// Each event keeps one of four calendar colors for the whole month, in order of appearance.
const colors = new Map<string, number>();
for (const seg of weeks.flatMap((w) => w.segments)) {
  if (!colors.has(seg.item.id)) colors.set(seg.item.id, (colors.size % 4) + 1);
}
const variant = (e: Listing) =>
  e.status === 'cancelled'
    ? 'cancelled'
    : e.status === 'postponed'
      ? 'warning'
      : `c${colors.get(e.id)}`;
const label = (e: Listing) =>
  `${e.displayName}, ${formatDateRange(e.start_date!, e.end_date!)}, ${e.city}${e.status === 'cancelled' ? ', cancelled' : e.status === 'postponed' ? ', postponed' : ''}`;

const agenda = weeks
  .flatMap((w) => w.days)
  .filter(inMonth)
  .map((day) => ({
    day,
    events: listings.filter((e) => e.start_date && e.start_date <= day && e.end_date! >= day),
  }))
  .filter((d) => d.events.length > 0);
---

<div class="cal">
  <div class="cal__dow" aria-hidden="true">
    {DOW.map((d) => (
      <div>{d}</div>
    ))}
  </div>
  <div role="group" aria-label={title}>
    {weeks.map((week) => (
      <div class="cal__week">
        {week.days.map((day, i) => (
          <div
            class:list={[
              'cal__bg',
              i === 0 && 'cal__bg--first',
              (i === 0 || i === 6) && inMonth(day) && 'cal__bg--weekend',
              !inMonth(day) && 'cal__bg--out',
            ]}
            style={`grid-column:${i + 1} / span 1`}
            aria-hidden="true"
          />
        ))}
        {week.days.map((day, i) => (
          <div class="cal__day" style={`grid-column:${i + 1}`} aria-hidden="true">
            <span
              class:list={[
                'cal__num',
                !inMonth(day) && 'cal__num--out',
                day === today && 'cal__num--today',
              ]}
            >
              {Number(day.slice(8))}
            </span>
          </div>
        ))}
        {week.segments.map((seg) => (
          <a
            class:list={[
              'cal__ev',
              `cal__ev--${variant(seg.item)}`,
              seg.continuesBefore && 'cal__ev--cont-l',
              seg.continuesAfter && 'cal__ev--cont-r',
            ]}
            href={detailHref(seg.item)}
            style={`grid-column:${seg.start + 1} / ${seg.end + 2};grid-row:${seg.lane + 2}`}
            aria-label={label(seg.item)}
            tabindex={seg.continuesBefore ? -1 : undefined}
            aria-hidden={seg.continuesBefore ? 'true' : undefined}
            data-listing={seg.item.id}
            data-region={seg.item.region}
            data-city={seg.item.city}
          >
            {seg.item.status === 'cancelled' && (
              <Icon name="circle-x" size={12} strokeWidth={2.2} />
            )}
            {seg.item.status === 'postponed' && (
              <Icon name="triangle-alert" size={12} strokeWidth={2.2} />
            )}
            <span>{seg.item.displayName}</span>
          </a>
        ))}
      </div>
    ))}
  </div>
  <div class="cal__legend">
    <span>
      <i class="legend-conv"></i>Convention
    </span>
    <span>
      <span class="legend-cancelled">
        <Icon name="circle-x" size={12} strokeWidth={2.2} />
      </span>
      <s>Cancelled</s>
    </span>
    <span>
      <span class="legend-warning">
        <Icon name="triangle-alert" size={12} strokeWidth={2.2} />
      </span>
      Postponed
    </span>
    <span>
      <i class="legend-today"></i>Today
    </span>
  </div>
</div>

<div class="agenda" aria-label={`${title} agenda`} role="group">
  {agenda.length === 0 && <div class="agenda__empty">No conventions in {title.split(' ')[0]}.</div>}
  {agenda.map(({ day, events }) => (
    <div class="agenda__day" data-filter-group>
      <div class:list={['agenda__d', day === today && 'agenda__d--today']}>
        <small>{weekday(day).toUpperCase()}</small>
        <b>{Number(day.slice(8))}</b>
      </div>
      <div class="agenda__list">
        {events.map((e) => (
          <a
            class:list={['agenda__ev', `cal__ev--${variant(e)}`]}
            href={detailHref(e)}
            aria-label={label(e)}
            data-listing={e.id}
            data-region={e.region}
            data-city={e.city}
          >
            {e.status === 'cancelled' && <Icon name="circle-x" size={14} strokeWidth={2.2} />}
            {e.status === 'postponed' && <Icon name="triangle-alert" size={14} strokeWidth={2.2} />}
            <span>{e.displayName}</span>
            <small>{e.city}</small>
          </a>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .cal {
    --lane: 26px;
    display: grid;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
    color: var(--text);
  }
  .cal__dow {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .cal__dow div {
    padding: 8px 0;
    text-align: center;
    font: var(--type-pixel);
    letter-spacing: 0.08em;
    color: var(--text-2);
    text-transform: uppercase;
  }
  .cal__week {
    position: relative;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    grid-template-rows: 34px;
    grid-auto-rows: var(--lane);
    border-bottom: 1px solid var(--divider);
    min-height: 96px;
    padding-bottom: 4px;
  }
  .cal__week:last-child {
    border-bottom: 0;
  }
  .cal__day {
    grid-row: 1;
    position: relative;
    height: 34px;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 4px 6px 0;
  }
  .cal__bg {
    position: absolute;
    inset: 0;
    grid-row: 1 / span 20;
    z-index: 0;
    border-left: 1px solid var(--divider);
    pointer-events: none;
  }
  .cal__bg--first {
    border-left: 0;
  }
  .cal__bg--weekend {
    background: var(--cal-weekend);
  }
  .cal__bg--out {
    background: repeating-linear-gradient(135deg, transparent 0 6px, var(--surface-2) 6px 7px);
  }
  .cal__num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font: var(--type-numeric);
    font-size: 14px;
    color: var(--text-2);
    position: relative;
    z-index: 2;
    font-variant-numeric: tabular-nums;
  }
  .cal__num--out {
    color: var(--text-muted);
  }
  .cal__num--today {
    background: var(--cal-today);
    color: var(--text-on-accent);
    font-weight: 700;
  }
  .cal__ev {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 2px 3px 0;
    padding: 0 7px;
    height: calc(var(--lane) - 4px);
    border-radius: var(--radius-xs);
    font: var(--type-caption);
    font-weight: 600;
    color: var(--cal-1-fg);
    background: var(--cal-1-bg);
    border-left: 3px solid var(--cal-1-border);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    transition: filter var(--dur-fast) var(--ease-out);
  }
  .cal__ev span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cal__ev:hover {
    filter: brightness(0.95);
  }
  :global([data-theme='dark']) .cal__ev:hover {
    filter: brightness(1.15);
  }
  .cal__ev:focus-visible,
  .agenda__ev:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }
  .cal__ev--c1 {
    color: var(--cal-1-fg);
    background: var(--cal-1-bg);
    border-color: var(--cal-1-border);
  }
  .cal__ev--c2 {
    color: var(--cal-2-fg);
    background: var(--cal-2-bg);
    border-color: var(--cal-2-border);
  }
  .cal__ev--c3 {
    color: var(--cal-3-fg);
    background: var(--cal-3-bg);
    border-color: var(--cal-3-border);
  }
  .cal__ev--c4 {
    color: var(--cal-4-fg);
    background: var(--cal-4-bg);
    border-color: var(--cal-4-border);
  }
  .cal__ev--cancelled {
    color: var(--cal-cancelled-fg);
    background: var(--cal-cancelled-bg);
    border-color: var(--cal-cancelled-border);
    text-decoration: line-through;
    font-weight: 500;
  }
  .cal__ev--warning {
    color: var(--status-warning-fg);
    background: var(--status-warning-bg);
    border-color: var(--status-warning-dot);
  }
  .cal__ev--cont-l {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    margin-left: 0;
  }
  .cal__ev--cont-r {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    margin-right: 0;
  }
  .cal__legend {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    padding: 10px 14px;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    font: var(--type-caption);
    color: var(--text-2);
  }
  .cal__legend > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .cal__legend i {
    width: 14px;
    height: 10px;
    border-radius: 2px;
    display: inline-block;
  }
  .legend-conv {
    background: var(--cal-1-bg);
    border-left: 3px solid var(--cal-1-border);
  }
  .cal__legend .legend-today {
    background: var(--cal-today);
    border-radius: 7px;
  }
  .legend-cancelled {
    display: inline-flex;
    color: var(--status-cancelled-fg);
  }
  .legend-warning {
    display: inline-flex;
    color: var(--status-warning-fg);
  }

  .agenda {
    display: grid;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
  }
  .agenda__day {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--divider);
    align-items: start;
  }
  .agenda__day:last-child {
    border-bottom: 0;
  }
  .agenda__d {
    text-align: center;
  }
  .agenda__d b {
    display: block;
    font: var(--type-date-day);
    font-size: 24px;
  }
  .agenda__d small {
    font: var(--type-pixel);
    color: var(--text-muted);
  }
  .agenda__d--today b {
    color: var(--cal-today);
  }
  .agenda__list {
    display: grid;
    gap: 6px;
  }
  .agenda__ev {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    /* Colors come from the shared .cal__ev--* variant classes. */
    border-left-width: 3px;
    border-left-style: solid;
    font: var(--type-body-sm);
    font-weight: 600;
  }
  .agenda__ev small {
    font-weight: 400;
    color: var(--text-2);
    margin-left: auto;
    white-space: nowrap;
  }
  .agenda__empty {
    padding: 24px;
    text-align: center;
    font: var(--type-body-sm);
    color: var(--text-muted);
  }

  @media (max-width: 767px) {
    .cal {
      display: none;
    }
  }
  @media (min-width: 768px) {
    .agenda {
      display: none;
    }
  }
</style>
